{
  "name": "cliquevertex-verifier-desktop",
  "productName": "Clique/Vertex Verifier",
  "version": "1.0.0",
  "private": true,
  "description": "NP Certificate Verifier — Clique & Vertex Cover (Windows desktop app)",
  "author": "Pranav Mohan Paunikar",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cliquevertex.verifier.desktop",
    "productName": "Clique/Vertex Verifier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "NP-Certificate-Verifier.exe"
    }
  }
}